[mysqld]
# match the starter's collation, so tables created without one (eg messenger_messages,
# doctrine_migration_versions) get it, instead of DDEV's utf8mb4_unicode_520_ci
character-set-server = utf8mb4
collation-server = utf8mb4_0900_bin
init_connect='SET collation_connection = utf8mb4_0900_bin'
