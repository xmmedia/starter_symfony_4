# editorconfig.org

root = true

[*]
charset = utf-8
indent_size = 4
indent_style = space
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

[{package.json,yarn.lock,.yarnrc.yml,.gitlab-ci.yml,.lando.yml,compose.yaml,compose.*.yaml,.github/workflows/*.yml}]
indent_size = 2
