<!DOCTYPE html>
<html lang="{{ app.request.getLocale()[:2] }}">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block page_title_wrap %}{% block page_title %}{% endblock %}{{ 'app.parameter.name'|trans }}{% endblock %}</title>

        {% block head %}{% endblock %}

        {% block stylesheets %}{% endblock %}
        {% block favicons %}
            {% include 'favicons.html.twig' %}
        {% endblock %}

        {% block analytics %}
            {% if ga_tracking_id %}
                <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga_tracking_id }}"></script>
                <script>
                    window.dataLayer = window.dataLayer || [];
                    function gtag(){dataLayer.push(arguments);}
                    gtag('js', new Date());

                    gtag('config', '{{ ga_tracking_id }}', {
                        anonymize_ip: true,
                    });
                </script>
            {% endif %}
        {% endblock %}
    </head>
    <body{% if body_attributes is defined %}{{ body_attributes }}{% endif %}>
        {# from an allowed IP: everyone else is seeing the maintenance page #}
        {% if app.request.attributes.get(constant('Xm\\SymfonyBundle\\Infrastructure\\Service\\MaintenanceGate::BYPASS_ATTRIBUTE')) %}
            <div class="fixed bottom-2 left-2 z-50 rounded bg-yellow-300 px-3 py-1 text-sm font-medium text-gray-900 shadow"
                 role="status">
                Maintenance mode is on – only allowed IPs can use the site
            </div>
        {% endif %}

        {% block body %}
            {% block header %}
                <header>
                    {# @todo-symfony this isn't visible if all SPA #}
                    <div><a href="{{ path('index') }}"><img src="/images/logo.svg" width="250" alt="{{ 'app.parameter.name'|trans }}"></a></div>
                </header>
            {% endblock header %}
            {% block content_wrap %}
                <main>
                    {% block content %}
                        {% include 'flash_messages.html.twig' %}
                    {% endblock content %}
                </main>
            {% endblock content_wrap %}
            {% block footer %}
                <footer>
                    <div class="text-sm">
                        ©{{ 'now'|date('Y') }} {{ 'app.parameter.name'|trans }} {{ "app.string.all_rights_reserved"|trans }}
                    </div>
                </footer>
            {% endblock footer %}
        {% endblock body %}

        {% block javascripts %}{% endblock %}
    </body>
</html>
