#!/usr/bin/env bash
# Provisions a new dev/staging site end to end.
#
# Orchestrates the steps from the "New Dev/Staging Site" Notion doc:
#   1. Create the 1Password server + database items, with generated passwords
#   2. Create the SiteWorx account (InterWorx nodeworx CLI, over ssh)
#   3. Create the database + database user
#   4. Upload and run setup_staging.sh or setup_prod.sh as the site user
#   5. (optional) Generate the Let's Encrypt SSL certificate
#   6. Write shared/.env.local, filling in what's known
#   7. (optional) Add the Messenger worker & log rotation cron jobs
#   8. Run bin/setup_gitlab_ci_vars locally
#
# The SSL certificate needs DNS in place — if it fails, it's left as a manual step in
# SiteWorx.
#
# Prerequisites:
#   - ssh access to the server via a configured ssh Host, with passwordless sudo
#   - op CLI signed in (op signin), glab authenticated, jq & openssl installed
#
# Usage: bin/provision_site
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_TEMPLATE="$SCRIPT_DIR/../.env"
NODEWORX='nodeworx'
SITEWORX='siteworx'
# Database name/user suffix — always symfony for this starter.
SITE_TYPE='symfony'

die() { echo -e "${RED}Error: $*${NC}" >&2; exit 1; }
heading() { echo ""; echo -e "${BOLD}${CYAN}$*${NC}"; }
ok() { echo -e "  ${GREEN}✓${NC} $*"; }
warn() { echo -e "  ${YELLOW}!${NC} $*"; }

# ask <label> [default]
ask() {
    local label="$1" default="${2:-}" result
    if [[ -n "$default" ]]; then
        read -r -p "$label [$default]: " result
        echo "${result:-$default}"
    else
        read -r -p "$label: " result
        echo "$result"
    fi
}

# ask_required <label> [default] — re-prompts until non-empty
ask_required() {
    local label="$1" default="${2:-}" result
    while true; do
        result=$(ask "$label" "$default")
        [[ -n "$result" ]] && break
        echo -e "  ${RED}Required.${NC}" >&2
    done
    echo "$result"
}

# confirm <question> [default y|n] — returns 0 for yes
confirm() {
    local question="$1" default="${2:-n}" prompt reply
    [[ "$default" == "y" ]] && prompt="[Y/n]" || prompt="[y/N]"
    read -r -p "$question $prompt: " reply
    reply="$(echo "${reply:-$default}" | tr '[:upper:]' '[:lower:]')"
    [[ "$reply" == "y" ]]
}

# shell-quote args for the remote shell
rq() {
    local out="" arg
    for arg in "$@"; do
        out+=" $(printf '%q' "$arg")"
    done
    printf '%s' "${out# }"
}

# remote <command> [args…] — runs a single command on the server
remote() { ssh "$SSH_HOST" "$(rq "$@")"; }

# generate_password — 32 letters, digits & URL-safe symbols (- . _ ~), with at least one of
# each kind (the servers' MySQL password policy requires a symbol). It starts with a letter or
# digit so a CLI can't read it as an option. Every character is unreserved in a URL, so it can
# go in a DSN unencoded, & none are special in a shell, .env or 1Password.
generate_password() {
    local value
    for _ in {1..20}; do
        value=$(openssl rand 512 | LC_ALL=C tr -dc 'A-Za-z0-9._~-' | cut -c1-32)
        if [[ ${#value} -eq 32 && "$value" =~ ^[A-Za-z0-9] && "$value" =~ [A-Z] && "$value" =~ [a-z]
            && "$value" =~ [0-9] && "$value" =~ [._~-] ]]; then
            printf '%s' "$value"
            return
        fi
    done
    die "failed to generate a password"
}

# create_op_item <password> <op item create args…> — prints the new item's id.
# The password goes in through a piped edit, as op only generates passwords for
# Login & Password items and assignment arguments show in the process list.
create_op_item() {
    local password="$1" item id
    shift
    item=$(op item create "$@" --format json) || die "failed to create the 1Password item"
    id=$(jq -r '.id' <<<"$item")
    if ! PASSWORD="$password" jq '(.fields[] | select(.id == "password")).value = env.PASSWORD' <<<"$item" \
            | op item edit "$id" --vault "$OP_VAULT" >/dev/null \
        || [[ "$(op item get "$id" --vault "$OP_VAULT" --fields password --reveal)" != "$password" ]]; then
        op item delete "$id" --vault "$OP_VAULT" >/dev/null 2>&1 || true
        die "failed to set the password on the 1Password item — item removed"
    fi
    printf '%s' "$id"
}

# add_cron <name> <minute> <hour> <dayofweek> <script> — adds a SiteWorx cron job, or warns
add_cron() {
    local name="$1" minute="$2" hour="$3" dayofweek="$4" script="$5"
    if remote sudo -n "$SITEWORX" -u -n --login_domain "$DOMAIN" -c Cron -a add \
        --interface simple \
        --minute "$minute" --hour "$hour" --day '*' --month '*' --dayofweek "$dayofweek" \
        --script "$script"; then
        ok "$name cron job added"
    else
        warn "failed to add the $name cron job — add it in SiteWorx instead"
    fi
}

# --- Preflight ---------------------------------------------------------------

command -v op   >/dev/null 2>&1 || die "op CLI not installed. Run: brew install 1password-cli"
command -v glab >/dev/null 2>&1 || die "glab CLI not installed. See: https://gitlab.com/gitlab-org/cli"
command -v jq   >/dev/null 2>&1 || die "jq not installed. Run: brew install jq"
op account list >/dev/null 2>&1 || die "Not signed in to 1Password. Run: op signin"
for script in setup_staging.sh setup_prod.sh; do
    [[ -f "$SCRIPT_DIR/$script" ]] || die "$script not found in $SCRIPT_DIR"
done
[[ -f "$SCRIPT_DIR/setup_gitlab_ci_vars" ]] || die "setup_gitlab_ci_vars not found in $SCRIPT_DIR"
[[ -f "$ENV_TEMPLATE" ]] || die ".env not found in $(dirname "$SCRIPT_DIR")"
command -v openssl >/dev/null 2>&1 || die "openssl not installed"

echo ""
echo -e "${BOLD}${CYAN}New Site Setup${NC}"

# --- Gather input ------------------------------------------------------------

heading "Environment"
echo "  1) staging"
echo "  2) production"
read -r -p "Which are you provisioning? [1]: " env_choice
case "${env_choice:-1}" in
    2|production) SCOPE="production"; APP_ENV="prod";    SETUP_SCRIPT="setup_prod.sh" ;;
    *)            SCOPE="staging";    APP_ENV="staging"; SETUP_SCRIPT="setup_staging.sh" ;;
esac

heading "Server"
SSH_HOST=$(ask_required "ssh Host name (from ~/.ssh/config, e.g. dev3)")
echo -n "  Connecting… "
remote true >/dev/null 2>&1 || die "cannot ssh to '$SSH_HOST'"
remote sudo -n true >/dev/null 2>&1 || die "no passwordless sudo on '$SSH_HOST'"
remote sudo -n sh -c "command -v $NODEWORX" >/dev/null 2>&1 \
    || die "'$NODEWORX' not on root's PATH on '$SSH_HOST' — is this an InterWorx server?"
echo -e "${GREEN}ok${NC}"

SERVER_HOST=$(ask_required "Server hostname (for 1Password + GitLab, e.g. dev3.xmmedia.com)" "${SSH_HOST}.xmmedia.com")

heading "Site"
DOMAIN=$(ask_required "Domain (e.g. example.com without the www prefix)")
DOMAIN="${DOMAIN#https://}"; DOMAIN="${DOMAIN#http://}"; DOMAIN="${DOMAIN%/}"
SITE_USER=$(ask_required "SiteWorx username (e.g. exampledev — avoid using 'dev' as the prefix)")
ADMIN_EMAIL=$(ask_required "InterWorx account email" "admin@xmmedia.com")
DB_NAME="${SITE_USER}_${SITE_TYPE}"
SITE_BASE="/home/$SITE_USER/$DOMAIN"

# Verify the account doesn't already exist
ACCOUNTS=$(remote sudo -n "$NODEWORX" -u -n -c Siteworx -a listAccounts) \
    || die "failed to list the SiteWorx accounts on $SSH_HOST"
if awk -F'\t' -v d="$DOMAIN" -v u="$SITE_USER" '$2==u || $10==d {found=1} END {exit !found}' <<<"$ACCOUNTS"; then
    die "a SiteWorx account for '$DOMAIN' or user '$SITE_USER' already exists on $SSH_HOST"
fi

heading "PHP"
PHP_AVAILABLE=$(remote sudo -n "$NODEWORX" -u -n -c Siteworx -a add --help \
    | awk '/^--php_version/ {print $NF}')
echo "  Available: $PHP_AVAILABLE"
PHP_PATH=$(ask "PHP version path" "$(echo "$PHP_AVAILABLE" | tr '|' '\n' | grep -E '^/opt/remi/php[0-9]+$' | tail -1)")

heading "1Password"
OP_VAULT=$(ask_required "Vault")
OP_TAG=$(ask "Tag (client name, optional)")

heading "Optional steps"
DO_GITLAB=n; confirm "Set the GitLab CI/CD variables?" y && DO_GITLAB=y || true
GITLAB_PROJECT=""
if [[ "$DO_GITLAB" == "y" ]]; then
    GITLAB_PROJECT=$(ask_required "GitLab project (e.g. xmmedia/my-client-site)")
fi
DO_SSL=n;    confirm "Generate the SSL certificate (DNS must already point at the server)?" y && DO_SSL=y || true
SSL_WWW=n
if [[ "$DO_SSL" == "y" ]]; then
    [[ "$SCOPE" == "production" ]] && www_default=y || www_default=n
    confirm "  Include www.$DOMAIN (needs its own DNS record)?" "$www_default" && SSL_WWW=y || true
fi
DO_CRON=n;   confirm "Add the Messenger worker cron job?" y && DO_CRON=y || true
DO_LOGROTATE=n; confirm "Add the log rotation cron job (weekly)?" y && DO_LOGROTATE=y || true

# --- Summary -----------------------------------------------------------------

heading "Summary"
printf "  %-22s %s\n" "environment"   "$SCOPE"
printf "  %-22s %s\n" "ssh host"      "$SSH_HOST"
printf "  %-22s %s\n" "server"        "$SERVER_HOST"
printf "  %-22s %s\n" "domain"        "$DOMAIN"
printf "  %-22s %s\n" "site user"     "$SITE_USER"
printf "  %-22s %s\n" "account email" "$ADMIN_EMAIL"
printf "  %-22s %s\n" "site base"     "$SITE_BASE"
printf "  %-22s %s\n" "database/user" "$DB_NAME"
printf "  %-22s %s\n" "PHP"           "$PHP_PATH"
printf "  %-22s %s\n" "1P vault"      "$OP_VAULT${OP_TAG:+ (tag: $OP_TAG)}"
if [[ "$DO_SSL" == "y" ]]; then
    printf "  %-22s %s\n" "SSL certificate" "$DO_SSL (www: $SSL_WWW)"
else
    printf "  %-22s %s\n" "SSL certificate" "$DO_SSL"
fi
printf "  %-22s %s\n" "GitLab vars"   "$DO_GITLAB${GITLAB_PROJECT:+ ($GITLAB_PROJECT)}"
printf "  %-22s %s\n" "worker cron"   "$DO_CRON"
printf "  %-22s %s\n" "logrotate cron" "$DO_LOGROTATE"
echo ""
confirm "Proceed? Everything after this point makes changes." n || { echo "Aborted."; exit 0; }

# --- 1. 1Password items ------------------------------------------------------

heading "1/8 Creating 1Password items"
SITE_PASSWORD=$(generate_password)
DB_PASSWORD=$(generate_password)

OP_ARGS=(--category server --title "$DOMAIN" --vault "$OP_VAULT"
    "username=$SITE_USER"
    'port[text]=10022'
    "path[text]=$SITE_BASE/current"
    "domain[text]=$DOMAIN"
    "url[text]=$SERVER_HOST")
if [[ -n "$OP_TAG" ]]; then OP_ARGS+=(--tags "$OP_TAG"); fi
OP_SERVER_ID=$(create_op_item "$SITE_PASSWORD" "${OP_ARGS[@]}")
ok "server item: $OP_SERVER_ID"

OP_ARGS=(--category database --title "$DOMAIN" --vault "$OP_VAULT"
    "username=$DB_NAME"
    "database[text]=$DB_NAME"
    'hostname[text]=localhost'
    'port[text]=3306'
    'database_type[text]=MySQL')
if [[ -n "$OP_TAG" ]]; then OP_ARGS+=(--tags "$OP_TAG"); fi
OP_DB_ID=$(create_op_item "$DB_PASSWORD" "${OP_ARGS[@]}")
ok "database item: $OP_DB_ID"

# --- 2. SiteWorx account -----------------------------------------------------

heading "2/8 Creating the SiteWorx account"
warn "the SiteWorx and database passwords are passed as CLI arguments — briefly visible in the"
echo "    server's process list, and kept in sudo's log (/var/log/secure) until it rotates out."

# Reproduce a package template by expanding its options into --OPT_* flags;
# nodeworx's Siteworx add has no --package option.
PACKAGE=$(ask "Package template" "Default")
PACKAGE_OPTS=$(remote sudo -n "$NODEWORX" -u -n -c Packages -a listPackages \
    | awk -F'\t' -v p="$PACKAGE" '$2==p {print $3}')
[[ -n "$PACKAGE_OPTS" ]] || die "package '$PACKAGE' not found on $SSH_HOST"

ALLOWED_FLAGS=$(remote sudo -n "$NODEWORX" -u -n -c Siteworx -a add --help \
    | grep -oE '^--[a-zA-Z_]+' | sed 's/^--//')
SW_ARGS=()
while IFS='=' read -r key value; do
    [[ -z "$key" || -z "$value" ]] && continue
    grep -qx "$key" <<<"$ALLOWED_FLAGS" || continue
    SW_ARGS+=("--$key" "$value")
done < <(tr ',' '\n' <<<"$PACKAGE_OPTS")

IPV4=$(remote sudo -n "$NODEWORX" -u -n -c Siteworx -a add --help \
    | awk '/^--master_domain_ipv4/ {print $NF}' | cut -d'|' -f1)
[[ -n "$IPV4" ]] || die "could not determine the IPv4 address for the account on $SSH_HOST"

remote sudo -n "$NODEWORX" -u -n -c Siteworx -a add \
    --master_domain "$DOMAIN" \
    --master_domain_ipv4 "$IPV4" \
    --uniqname "$SITE_USER" \
    --email "$ADMIN_EMAIL" \
    --encrypted n \
    --password "$SITE_PASSWORD" \
    --confirm_password "$SITE_PASSWORD" \
    --requires_password_change 0 \
    --language en-us \
    --php_version "$PHP_PATH" \
    --php_available "$PHP_PATH" \
    --create_package 0 \
    --restart_httpd 1 \
    "${SW_ARGS[@]}" \
    || die "failed to create the SiteWorx account"
ok "account created ($SITE_USER / $DOMAIN)"

# --- 3. Database -------------------------------------------------------------

heading "3/8 Creating the database and user"
# InterWorx prefixes both with the account username, so pass the suffix only.
remote sudo -n "$SITEWORX" -u -n --login_domain "$DOMAIN" -c MysqlDb -a add \
    --name "$SITE_TYPE" \
    --create_user 1 \
    --user "$SITE_TYPE" \
    --password "$DB_PASSWORD" \
    --confirm_password "$DB_PASSWORD" \
    --host localhost \
    || die "failed to create the database"
ok "database and user created ($DB_NAME)"

# SiteWorx has no collation option. Tables created without one (eg messenger_messages,
# doctrine_migration_versions) take the database's, so match the rest of the schema.
# The password goes in on stdin as an option file, so it's not in either process list.
if printf '[client]\npassword="%s"\n' "$DB_PASSWORD" \
    | remote mysql --defaults-file=/dev/stdin -u "$DB_NAME" "$DB_NAME" \
        -e "ALTER DATABASE \`$DB_NAME\` CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin"; then
    ok "database collation set (utf8mb4_0900_bin)"
else
    warn "failed to set the database collation — run in phpMyAdmin:"
    warn "  ALTER DATABASE \`$DB_NAME\` CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin;"
fi

# --- 4. Server setup script --------------------------------------------------

heading "4/8 Running $SETUP_SCRIPT"
# The account's real path — /chroot/home/… on chrooted servers, /home/… otherwise.
REAL_BASE=$(remote sudo -n "$NODEWORX" -u -n -c Siteworx -a listAccounts \
    | awk -F'\t' -v u="$SITE_USER" '$2==u {print $21}')
[[ -n "$REAL_BASE" ]] || die "could not determine the site path for '$SITE_USER' on $SSH_HOST"
echo "  Site path on server: $REAL_BASE"

REMOTE_TMP=$(remote mktemp) || die "failed to create a temp file on $SSH_HOST"
scp -q "$SCRIPT_DIR/$SETUP_SCRIPT" "$SSH_HOST:$REMOTE_TMP" || die "failed to copy $SETUP_SCRIPT"
remote sudo -n install -o "$SITE_USER" -g "$SITE_USER" -m 755 \
    "$REMOTE_TMP" "$REAL_BASE/$SETUP_SCRIPT" \
    || die "failed to place $SETUP_SCRIPT in the site directory"
remote rm -f "$REMOTE_TMP"

# Run as the site user, in the domain dir; "Y" answers the script's confirm prompt.
remote sudo -n su - "$SITE_USER" -c "cd $(printf '%q' "$DOMAIN") && echo Y | bash ./$SETUP_SCRIPT" \
    || die "$SETUP_SCRIPT failed — fix and re-run it manually on the server"
ok "site directory structure created"

# --- 5. SSL certificate ------------------------------------------------------

heading "5/8 SSL certificate"
SSL_INSTALLED=n
SSL_NOTE=""
if [[ "$DO_SSL" == "y" ]]; then
    while true; do
        SSL_NAMES="$DOMAIN"
        [[ "$SSL_WWW" == "y" ]] && SSL_NAMES+=",www.$DOMAIN"
        # Without --subjectAltName the CLI adds www itself, & fails if it doesn't resolve
        if remote sudo -n "$SITEWORX" -u -n --login_domain "$DOMAIN" -c Ssl -a generateLetsEncrypt \
            --domain "$DOMAIN" --commonName "$DOMAIN" --subjectAltName "$SSL_NAMES"; then
            SSL_INSTALLED=y
            ok "certificate generated for ${SSL_NAMES//,/ & }"
            break
        fi
        warn "failed to generate the certificate — the reason is in the LetsEncrypt log"
        echo "    (SiteWorx → Administration → Logs)"
        confirm "Retry? (e.g. once DNS has propagated)" n || break
        confirm "  Include www.$DOMAIN?" "$SSL_WWW" && SSL_WWW=y || SSL_WWW=n
    done
    if [[ "$SSL_INSTALLED" != "y" ]]; then
        SSL_NOTE="The CLI failed — the reason is in the LetsEncrypt log (Administration → Logs)"
        warn "left as a manual step"
    fi
else
    echo "  Skipped."
fi

# --- 6. .env.local -----------------------------------------------------------

heading "6/8 Writing shared/.env.local"
REMOTE_ENV="$REAL_BASE/shared/.env.local"
if remote sudo -n test -s "$REMOTE_ENV"; then
    warn "$REMOTE_ENV already has content — left as is."
else
    # The repo's .env with what's known filled in. It overrides .env; the deploy copies it into
    # each release & runs composer dump-env. The passwords are URL safe (see generate_password),
    # so they go in the URL unencoded.
    ENV_CONTENT=$(
        APP_ENV="$APP_ENV" \
        APP_SECRET="$(generate_password)" \
        DATABASE_URL="\"mysql://$DB_NAME:$DB_PASSWORD@localhost:3306/$DB_NAME?serverVersion=8.4&charset=utf8mb4\"" \
        REQUEST_CONTEXT_HOST="$DOMAIN" \
        REQUEST_CONTEXT_SCHEME=https \
        awk -v keys='APP_ENV APP_SECRET DATABASE_URL REQUEST_CONTEXT_HOST REQUEST_CONTEXT_SCHEME' '
            BEGIN { n = split(keys, k, " "); for (i = 1; i <= n; i++) set[k[i]] = 1 }
            { key = $0; sub(/=.*/, "", key) }
            /^[A-Z_]+=/ && (key in set) { print key "=" ENVIRON[key]; next }
            { print }
        ' "$ENV_TEMPLATE"
    )

    # Written to a temp file beside it & moved into place, so a failed write can't leave a
    # partial file (which the next run would skip)
    printf '%s\n' "$ENV_CONTENT" | remote sudo -n sh -c "tmp=\$(mktemp $(printf '%q' "$REMOTE_ENV").XXXXXX) \
        && chown $(printf '%q' "$SITE_USER:$SITE_USER") \"\$tmp\" \
        && chmod 600 \"\$tmp\" \
        && cat > \"\$tmp\" \
        && mv \"\$tmp\" $(printf '%q' "$REMOTE_ENV") \
        || { rm -f \"\$tmp\"; exit 1; }" \
        || die "failed to write $REMOTE_ENV"
    ok "written: environment, app secret, database and request context"
fi

# --- 7. Cron jobs ------------------------------------------------------------

heading "7/8 Cron jobs"
# Starts a worker every 5 minutes unless one's running (flock). The worker exits after an
# hour, or when a deploy runs messenger:stop-workers, & the next run starts a new one.
if [[ "$DO_CRON" == "y" ]]; then
    add_cron "Messenger worker" '*/5' '*' '*' \
        "cd $SITE_BASE/current && flock -n var/messenger.lock bin/console messenger:consume async --time-limit=3600 --memory-limit=128M --quiet 2>&1"
else
    echo "  Messenger worker: skipped."
fi
# Rotates var/log/*.log (config/packages/logrotate.conf) every Monday at 3am. var/ is shared
# between releases, so the state file survives deploys.
if [[ "$DO_LOGROTATE" == "y" ]]; then
    add_cron "log rotation" '0' '3' '1' \
        "cd $SITE_BASE/current && /usr/sbin/logrotate config/packages/logrotate.conf --state var/logrotate-state"
else
    echo "  Log rotation: skipped."
fi

# --- 8. GitLab CI variables --------------------------------------------------

heading "8/8 GitLab CI/CD variables"
KEY_INSTALLED=n
if [[ "$DO_GITLAB" == "y" ]]; then
    PUBLIC_KEY_FILE=$(mktemp)
    trap 'rm -f "$PUBLIC_KEY_FILE"' EXIT
    if "$SCRIPT_DIR/setup_gitlab_ci_vars" "$GITLAB_PROJECT" \
        --scope "$SCOPE" \
        --remote-base "$SITE_BASE" \
        --remote-server "$SERVER_HOST" \
        --remote-user "$SITE_USER" \
        --context-host "$DOMAIN" \
        --public-key-out "$PUBLIC_KEY_FILE"; then
        PUBLIC_KEY=$(<"$PUBLIC_KEY_FILE")
        QUOTED_KEY=$(printf '%q' "$PUBLIC_KEY")
        # Added unless it's already there (an existing key can be reused across sites)
        if [[ -z "$PUBLIC_KEY" ]]; then
            warn "could not read the CI public key — add it to ~/.ssh/authorized_keys yourself"
        elif remote sudo -n su - "$SITE_USER" -c "umask 077 && mkdir -p ~/.ssh \
            && touch ~/.ssh/authorized_keys \
            && { grep -qxF $QUOTED_KEY ~/.ssh/authorized_keys \
                || printf '%s\n' $QUOTED_KEY >> ~/.ssh/authorized_keys; }"; then
            KEY_INSTALLED=y
            ok "CI public key added to ~/.ssh/authorized_keys for $SITE_USER"
        else
            warn "failed to add the CI public key — add it to ~/.ssh/authorized_keys yourself:"
            echo "    $PUBLIC_KEY"
        fi
    else
        warn "setup_gitlab_ci_vars did not complete"
    fi
else
    echo "  Skipped."
fi

# --- Done --------------------------------------------------------------------

STEP=0
manual_step() { STEP=$((STEP + 1)); echo -e "  ${BOLD}$STEP.${NC} $*"; }

echo ""
echo -e "${GREEN}Done!${NC}"
echo ""
echo -e "  The SiteWorx and database passwords are in 1Password: vault ${YELLOW}$OP_VAULT${NC},"
echo -e "  the server and database items titled ${YELLOW}$DOMAIN${NC}."
echo ""
echo ""
echo -e "${BOLD}${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BOLD}  Remaining manual steps${NC}"
echo -e "${BOLD}${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
manual_step "Add the DNS record for ${YELLOW}$DOMAIN${NC} if it isn't in place yet"
if [[ "$SSL_INSTALLED" != "y" ]]; then
    manual_step "Generate the SSL certificate in SiteWorx, once DNS has propagated"
    if [[ -n "$SSL_NOTE" ]]; then echo -e "     $SSL_NOTE"; fi
    echo -e "     Log in as ${YELLOW}$SITE_USER${NC} at ${YELLOW}https://$SERVER_HOST:2443/${NC} → SSL/TLS → Let's Encrypt"
    echo -e "     Untick ${YELLOW}www.$DOMAIN${NC} unless it has its own DNS record"
fi
if [[ "$KEY_INSTALLED" != "y" ]]; then
    manual_step "Add the CI public key to ~/.ssh/authorized_keys for ${YELLOW}$SITE_USER${NC} on ${YELLOW}$SSH_HOST${NC}"
fi
manual_step "Complete ${YELLOW}$SITE_BASE/shared/.env.local${NC}"
echo "     Fill in the email settings, Sentry DSN & trusted proxies; check the MySQL serverVersion"
SENTRY_ORG=$(sed -nE "s/^[[:space:]]*org: '([^']*)'.*/\1/p" "$SCRIPT_DIR/../vite.config.mjs" | head -n 1)
SENTRY_PROJECT=$(sed -nE "s/^[[:space:]]*project: '([^']*)'.*/\1/p" "$SCRIPT_DIR/../vite.config.mjs" | head -n 1)
manual_step "Check the Sentry org & project slugs in ${YELLOW}vite.config.mjs${NC} match the Sentry project"
echo -e "     Currently org ${YELLOW}${SENTRY_ORG:-?}${NC}, project ${YELLOW}${SENTRY_PROJECT:-?}${NC} — if they're wrong, the source map"
echo "     upload fails (only as a warning, so the deploy still passes) & stack traces stay minified"
manual_step "Upload the files to ${YELLOW}$SITE_BASE/shared/public/uploads${NC} & import the database"
manual_step "Deploy from GitLab (the first attempt often fails — fix and retry)"
