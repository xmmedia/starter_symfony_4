#!/bin/bash

set -Ee

# shellcheck source=bin/_output.sh
. "$(dirname "$0")/_output.sh"
trap report_failure ERR

# `ddev exec` & one sync, as in bin/check, which syncs the fixers' changes back to the host
step "Sync files" ddev mutagen sync
step "Composer normalize" ddev exec composer normalize
step "Rector" ddev exec composer rector
step "PHP CS Fixer" ddev exec composer cs:fix
step "Generate GraphQL schema" env SKIP_MUTAGEN_SYNC=1 bin/generate_schema

# bin/check prints its own step output & success message
trap - ERR
bin/check
