# for CI and a basic analysis
includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/phpstan/phpstan-webmozart-assert/extension.neon
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon
    - vendor/phpstan/phpstan-mockery/extension.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/ekino/phpstan-banned-code/extension.neon
    - vendor/marc-mabe/php-enum-phpstan/extension.neon

parameters:
    level: 5
    ignoreErrors:
        # prooph rebinds the when() closures to the projector, so $this really is
        # a ReadModelProjector at runtime, not the projection class
        -
            identifier: varTag.nativeType
            path: src/Projection/*/*Projection.php
        # the 2nd param is commented out of the interface for BC, but the helper accepts it
        -
            message: '#generateResetToken\(\) invoked with 2 parameters, 1 required#'
            path: src/Model/User/Handler/SendActivationHandler.php
        # hydrated by Doctrine, never assigned in PHP
        -
            identifier: property.onlyRead
            path: src/Entity/User.php
        # scaffolding for the (empty) src/Security/Voter directory
        -
            identifier: trait.unused
            path: tests/Security/Voter/VoterSecurityTrait.php
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        - public/js
    symfony:
        containerXmlPath: '%rootDir%/../../../cache/test/App_KernelTestDebugContainer.xml'
        consoleApplicationLoader: tests/console-application.php
    doctrine:
        objectManagerLoader: tests/object-manager.php
    banned_code:
        # errors emitted by the extension are non-ignorable by default, so they cannot accidentally be put into the baseline.
        non_ignorable: false
