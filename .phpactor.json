{
    "language_server_phpstan.enabled": true,
    "language_server_phpstan.bin": "%project_root%/bin/phpstan",
    "language_server_php_cs_fixer.enabled": true,
    "language_server_php_cs_fixer.bin": "%project_root%/bin/php-cs-fixer",
    "symfony.enabled": true,
    "symfony.xml_path": "%project_root%/cache/dev/App_KernelDevDebugContainer.xml",
    "indexer.exclude_patterns": [
        "/vendor/**/Tests/**/*",
        "/vendor/**/tests/**/*",
        "/vendor/composer/**/*",
        "/cache/**/*",
        "/var/cache/**/*"
    ]
}
