{# default Sliding pagination control implementation #}

{% if pageCount > 1 %}
    <div class="flow-root mx-auto my-4 text-center">
        {% if first is defined and current != first %}
            <a href="{{ path(route, query|merge({(pageParameterName): first})) }}" class="inline-block w-12 p-1 hover:bg-blue-100 rounded hover:no-underline">&lt;&lt;</a>
        {% else %}
            <span class="inline-block w-12 p-1 text-gray-800">&lt;&lt;</span>
        {% endif %}

        {% if previous is defined %}
            <a href="{{ path(route, query|merge({(pageParameterName): previous})) }}" class="inline-block w-12 p-1 hover:bg-blue-100 rounded hover:no-underline">&lt;</a>
        {% else %}
            <span class="inline-block w-12 p-1 text-gray-800">&lt;</span>
        {% endif %}

        {% for page in pagesInRange %}
            {% if page != current %}
                <a href="{{ path(route, query|merge({(pageParameterName): page})) }}" class="hidden lg:inline-block w-12 p-1 hover:bg-blue-100 rounded hover:no-underline">{{ page }}</a>
            {% else %}
                <span class="hidden lg:inline-block w-12 p-1 border border-gray-400 rounded text-black">{{ page }}</span>
            {% endif %}

        {% endfor %}

        {% if next is defined %}
            <a href="{{ path(route, query|merge({(pageParameterName): next})) }}" class="inline-block w-12 p-1 hover:bg-blue-100 rounded hover:no-underline">&gt;</a>
        {% else %}
            <span class="inline-block w-12 p-1 text-gray-800">&gt;</span>
        {% endif %}

        {% if last is defined and current != last %}
            <a href="{{ path(route, query|merge({(pageParameterName): last})) }}" class="inline-block w-12 p-1 hover:bg-blue-100 rounded hover:no-underline">&gt;&gt;</a>
        {% else %}
            <span class="inline-block w-12 p-1 text-gray-800">&gt;&gt;</span>
        {% endif %}
    </div>
{% endif %}
